#random forest thresholds 

def RF_plots(data, tests, threshold_or_randst = None):
    #initialize plots
    n = np.sqrt(len(tests))
    if int(n) == n:
        m = int(n)
    else:
        m= int(n)+1
    fig, axes = plt.subplots(nrows=int(n), ncols=m, figsize=(15,10))

    #takes the list of threshold values and runs the random forest classifier for each one
    for threshold, ax in zip(tests, axes.flatten()):

        #initalize dataframe
        image_df = pd.DataFrame(data)

        #replace column values with true or false based on threshold
        for col in image_df:
            image_df[col] = image_df[col].apply(lambda x: True if x > threshold else False)

        #training and testing groups
        x, y = image_df, labels
        x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=32)

        #initalize model
        model_rf = RandomForestClassifier(random_state=32)
        model_rf.fit(x_train, y_train)
        
        # get accuracy and confusion matrix
        sc = model_rf.score(x_test, y_test)
        y_pred = model_rf.predict(x_test)
        ConfusionMatrixDisplay.from_predictions(y_test, y_pred, ax=ax)
        ax.title.set_text(f"Score: {sc}\n threshold: {threshold}")
    
    plt.tight_layout()
    plt.show()

thresholds = [.1, .4, .5, .6, .7, .8, .9,.95, 1]

print("thresholds:")
RF_plots(data, thresholds)
