#SVM comparisons poly and rbf (appendix)
#adapted from https://www.geeksforgeeks.org/python/rbf-svm-parameters-in-scikit-learn/

#tests different combinations of gamma and C parameters for SVM. 
#inputs are data, labels and 
#test_kernel = "rbf" or "poly" depending on what kernel is being tested.
def test_kernel(data, labels, test_kernel):
    # load and preprocess the data
    X = list(data)
    y = list(labels)
    
    
    # define the parameter grid
    param_grid = {'C': [0.001, 0.01, 0.1, 1, 10, 100, 1000],
                  'gamma':[0.0001, 0.001, 0.01, 1, 10, 100, 1000]}
    
    # perform grid search
    svm = SVC(kernel=test_kernel)
    grid_search = GridSearchCV(svm, 
                               param_grid, 
                               cv=3, # number of folds in cross validation  
                               n_jobs=-1)
    
    grid_search.fit(X, y)
    
    print(
        "Kernel: {} \nBest parameters are {} \nScore : {}%".format(
            test_kernel, grid_search.best_params_, grid_search.best_score_*100)
    )
    
    # Reshape for heatmap
    scores = grid_search.cv_results_["mean_test_score"].reshape(
        len(param_grid['gamma']),
        len(param_grid['C']))
    
    # Heatmap
    sns.heatmap(scores, 
                cmap = plt.cm.hot,
                annot= True, 
                cbar= True, 
                square=True)

    #plot labels
    plt.xlabel("gamma")
    plt.ylabel("C")
    plt.xticks(np.arange(len(param_grid['gamma'])), param_grid['gamma'], rotation=45)
    plt.yticks(np.arange(len(param_grid['C'])), param_grid['C'], rotation=0)
    
    plt.title("Accuracy for different parameters")
    plt.show()
    
    ## Plot accuracy vs C parameter
    plt.figure(figsize=(10, 6))
    plt.title("Accuracy vs C parameter")
    plt.xlabel("C")
    plt.ylabel("Accuracy")
    n = len(param_grid['C'])
    for i in range(n):
        plt.plot(param_grid['C'], 
                 scores[:,i], 
                 'o-', label='gamma='+str(param_grid['gamma'][i]))
    
    plt.legend()
    plt.xscale('log')
    plt.show()

#run analysis
test_kernel(data, labels, "rbf")
test_kernel(data, labels, "poly")


